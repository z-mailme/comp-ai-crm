model MailboxSync {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  source String

  businessUnitId String?
  businessUnit   BusinessUnit? @relation(fields: [businessUnitId], references: [id], onDelete: SetNull)

  status       GoogleSyncStatus @default(IDLE)
  cursor       String?
  lastSyncedAt DateTime?
  lastError    String?
  retryAfter   DateTime?
  autoCreate   Boolean          @default(false)

  initialBackfilledAt DateTime?
  backfillPageToken   String?
  backfillStartedAt   DateTime?
  backfillWindowStart DateTime?
  backfillWindowEnd   DateTime?
  lastFullReconcileAt DateTime?

  gmailLabels GmailLabel[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, source])
  @@index([status])
  @@index([businessUnitId, source])
  @@index([source, initialBackfilledAt])
  @@map("mailboxSync")
}

model GmailLabel {
  id            String      @id @default(cuid())
  mailboxSyncId String
  mailboxSync   MailboxSync @relation(fields: [mailboxSyncId], references: [id], onDelete: Cascade)

  gmailLabelId String
  name         String
  type         String

  colorBackground String?
  colorText       String?

  messagesTotal  Int?
  messagesUnread Int?
  threadsTotal   Int?
  threadsUnread  Int?

  labelListVisibility   String?
  messageListVisibility String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mailboxSyncId, gmailLabelId])
  @@map("gmailLabel")
}

model MailboxHistoricalImportJob {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  source String @default("gmail")

  requestedAfter  DateTime
  requestedBefore DateTime
  status          MailboxHistoricalImportJobStatus @default(PLANNING)

  totalMessages         Int @default(0)
  processedMessages     Int @default(0)
  writtenMessages       Int @default(0)
  alreadyStoredMessages Int @default(0)
  ignoredMessages       Int @default(0)
  remainingMessages     Int @default(0)
  totalChunks           Int @default(0)
  completedChunks       Int @default(0)

  currentChunkId String?
  retryAfterAt   DateTime?
  leaseExpiresAt DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  verifiedAt     DateTime?
  lastError      String?

  chunks MailboxHistoricalImportChunk[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, retryAfterAt])
  @@index([status, leaseExpiresAt])
  @@index([userId, source, requestedAfter, requestedBefore])
  @@map("mailboxHistoricalImportJob")
}

model MailboxHistoricalImportChunk {
  id    String                     @id @default(cuid())
  jobId String
  job   MailboxHistoricalImportJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  after     DateTime
  before    DateTime
  sortIndex Int
  depth     Int                                @default(0)
  status    MailboxHistoricalImportChunkStatus @default(PENDING)

  messagesMatched       Int?
  messagesAlreadyStored Int      @default(0)
  messagesAttempted     Int      @default(0)
  messagesWritten       Int      @default(0)
  messagesIgnored       Int      @default(0)
  messagesRemaining     Int      @default(0)
  ignoredMessageIds     String[] @default([])

  retryAfterAt    DateTime?
  attemptCount    Int       @default(0)
  lastError       String?
  failedMessageId String?
  startedAt       DateTime?
  completedAt     DateTime?
  verifiedAt      DateTime?

  verificationStatus MailboxHistoricalImportVerificationStatus @default(UNVERIFIED)
  verificationError  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, after, before])
  @@index([jobId, sortIndex])
  @@index([jobId, status])
  @@index([status, retryAfterAt])
  @@map("mailboxHistoricalImportChunk")
}

model EmailThread {
  id            String             @id @default(cuid())
  rootMessageId String             @unique
  subject       String?
  matchStatus   MailboxMatchStatus @default(UNMATCHED)

  companyId String?
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  bookingId String?
  booking   Booking? @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  firstMessageAt DateTime
  lastMessageAt  DateTime
  messageCount   Int      @default(0)

  messages     EmailMessage[]
  activity     Activity?
  conversation Conversation?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId, lastMessageAt])
  @@index([contactId, lastMessageAt])
  @@index([dealId, lastMessageAt])
  @@index([bookingId, lastMessageAt])
  @@index([matchStatus, lastMessageAt])
  @@map("emailThread")
}

model EmailMessage {
  id       String      @id @default(cuid())
  threadId String
  thread   EmailThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  rfcMessageId     String  @unique
  syncedByUserId   String?
  gmailMessageId   String?
  gmailThreadId    String?
  labelIds         String[] @default([])
  outlookMessageId String?
  outlookWebLink   String?

  direction  EmailDirection
  fromEmail  String
  fromName   String?
  recipients Json
  subject    String?
  snippet    String?
  body       String?
  sentAt     DateTime

  communicationMessage CommunicationMessage?

  createdAt DateTime @default(now())

  @@index([threadId, sentAt])
  @@index([gmailThreadId])
  @@index([labelIds], type: Gin)
  @@map("emailMessage")
}

