model BusinessUnit {
  id String @id @default(cuid())

  name        String
  slug        String
  description String?
  status      BusinessUnitStatus @default(ACTIVE)

  ownerId String?
  owner   User?   @relation("BusinessUnitOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  settings Json?

  channelAccounts         ChannelAccount[]
  marketingIntegrations   MarketingIntegration[]
  marketingAudiences      MarketingAudience[]
  marketingCreativeAssets MarketingCreativeAsset[]
  calendarEvents          CalendarEvent[]
  mailboxSyncs            MailboxSync[]
  customerIdentities      CustomerIdentity[]
  conversations           Conversation[]
  businessEvents          BusinessEvent[]
  businessKnowledge       BusinessKnowledge[]
  approvals               ApprovalRequest[]
  knowledgeItems          KnowledgeItem[]
  businessRules           BusinessRule[]
  memoryLinks             ExternalMemoryLink[]
  businessTasks           BusinessTask[]
  automationRules         AutomationRule[]
  agentSafetyPolicies     AgentSafetyPolicy[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug])
  @@index([status, name])
  @@map("businessUnit")
}

model ChannelAccount {
  id String @id @default(cuid())

  businessUnitId String?
